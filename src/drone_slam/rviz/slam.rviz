Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.55
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 36
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Cell Size: 1
      Plane Cell Count: 30
      Color: 110; 110; 120
      Alpha: 0.4
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Arrows: false
      Marker Scale: 0.6
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Droni
      Enabled: true
      Topic:
        Value: /drone_model
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: Droni i vërtetë (Gazebo)
      Enabled: true
      Topic:
        Value: /drone_model_gt
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: SLAM 3D Map (pa tokë)
      Enabled: true
      Topic:
        Value: /cloud_map_filtered
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Decay Time: 0
      Alpha: 1
    - Class: rviz_default_plugins/Map
      Name: 2D Map (e filtruar)
      Enabled: true
      Topic:
        Value: /map_filtered
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: 2D Planning Map
      Enabled: false
      Topic:
        Value: /planning_map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.6
      Color Scheme: map
    - Class: rviz_default_plugins/PointCloud2
      Name: Live Lidar
      Enabled: false
      Topic:
        Value: /lidar/points
        Depth: 30
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Decay Time: 0
      Alpha: 0.8
    - Class: rviz_default_plugins/Path
      Name: Ground Truth Trajectory
      Enabled: true
      Topic:
        Value: /gt_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 70; 230; 90
      Line Style: Billboards
      Line Width: 0.03
      Alpha: 1
    - Class: rviz_default_plugins/Path
      Name: Planned Route
      Enabled: true
      Topic:
        Value: /planned_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color: 255; 210; 0
      Line Style: Billboards
      Line Width: 0.06
      Pose Style: Axes
      Axes Length: 0.3
      Axes Radius: 0.03
      Alpha: 1
    - Class: rviz_default_plugins/Odometry
      Name: Lidar Odometry
      Enabled: false
      Topic:
        Value: /odom
        Reliability Policy: Reliable
      Keep: 50
      Shape:
        Value: Arrow
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.068
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      # fixed over the whole house (x -8..24, y -11..11), almost top-down,
      # x to the right: easy to click 2D Pose Estimate / 2D Goal Pose
      Target Frame: <Fixed Frame>
      Distance: 30
      Pitch: 1.3
      Yaw: 4.712
      Focal Point:
        X: 8
        Y: -1.5
        Z: 0
Window Geometry:
  Width: 1200
  Height: 800
  Displays:
    collapsed: false
