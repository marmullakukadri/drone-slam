<?xml version="1.0"?>
<!-- SLAM test world: 24x16 m indoor area with corridors, pillars and crates.
     Generated layout; the drone starts at the origin. -->
<sdf version="1.9">
  <world name="slam_world">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_n">
      <static>true</static>
      <pose>4 8 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>24 0.2 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24 0.2 4.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>4 -8 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>24 0.2 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>24 0.2 4.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>16 0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 16 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16 4.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-8 0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 16 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 16 4.0</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_in1">
      <static>true</static>
      <pose>4 3 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.2 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.2 4.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_in2">
      <static>true</static>
      <pose>4 -3 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8 0.2 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8 0.2 4.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_in3">
      <static>true</static>
      <pose>11 5.5 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 5 4.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 5 4.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_0">
      <static>true</static>
      <pose>-4 5 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>-4 -5 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>13 -5 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_3">
      <static>true</static>
      <pose>2 6 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_4">
      <static>true</static>
      <pose>9 -6 2.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_0">
      <static>true</static>
      <pose>-5 0 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 1.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 1.2 1.0</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_1">
      <static>true</static>
      <pose>0 -6 1.1 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 2.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 2.2</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_2">
      <static>true</static>
      <pose>7 6.5 0.4 0 0 0.6</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 1.5 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 1.5 0.8</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_3">
      <static>true</static>
      <pose>14 2 1.5 0 0 0.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 3.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 3.0</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_4">
      <static>true</static>
      <pose>-6 -6.5 0.8 0 0 0.8</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 1.6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 1.6</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_5">
      <static>true</static>
      <pose>6 -6.8 0.6 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.6 1.6 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.6 1.6 1.2</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="crate_6">
      <static>true</static>
      <pose>12.5 -1 1.25 0 0 1.0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 2.5</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- The drone (models/slam_drone, name "drone") is spawned by
         slam_sim.launch.py so its start pose can be chosen per run. -->
  </world>
</sdf>
