      </visual>
      <visual name="skid_left">
        <pose>0 0.09 -0.09 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.24</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="skid_right">
        <pose>0 -0.09 -0.09 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.24</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0.10 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/lidar</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.2618</min_angle>
              <max_angle>0.2618</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.4</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <link name="prop_fl">
      <pose>0.177 0.177 0.038 0 0 0.3</pose>
      <gravity>false</gravity>
      <inertial><mass>0.005</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="blade">
        <geometry><box><size>0.24 0.02 0.004</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="hub">
        <pose>0 0 0.004 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>
    <joint name="prop_fl_joint" type="revolute">
      <parent>base_link</parent><child>prop_fl</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <link name="prop_fr">
      <pose>0.177 -0.177 0.038 0 0 1.2</pose>
      <gravity>false</gravity>
