        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.30 0.20 0.10</size></box></geometry>
      </collision>
      <collision name="skid_left_collision">
        <pose>0 0.09 -0.09 0 0 0</pose>
        <geometry><box><size>0.24 0.016 0.016</size></box></geometry>
      </collision>
      <collision name="skid_right_collision">
        <pose>0 -0.09 -0.09 0 0 0</pose>
        <geometry><box><size>0.24 0.016 0.016</size></box></geometry>
      </collision>
      <visual name="body_shell">
        <geometry><ellipsoid><radii>0.13 0.085 0.04</radii></ellipsoid></geometry>
        <material>
          <ambient>0.13 0.13 0.15 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse>
