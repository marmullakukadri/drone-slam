        <geometry><box><size>0.24 0.02 0.004</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="hub">
        <pose>0 0 0.004 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>
    <joint name="prop_rl_joint" type="revolute">
      <parent>base_link</parent><child>prop_rl</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <link name="prop_rr">
      <pose>-0.177 -0.177 0.038 0 0 2.0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.005</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial>
      <visual name="blade">
        <geometry><box><size>0.24 0.02 0.004</size></box></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="hub">
        <pose>0 0 0.004 0 0 0</pose>
        <geometry><cylinder><radius>0.009</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.62 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material>
      </visual>
    </link>
    <joint name="prop_rr_joint" type="revolute">
